# --- Infrastructure ---
DATABASE_URL=postgresql://app:app@localhost:5432/amz_saas?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Files ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# --- Worker ---
WORKER_CONCURRENCY=4
IMPORT_CHUNK_SIZE=200
# Max jobs started per queue per minute (BullMQ limiter)
QUEUE_RATE_LIMIT_PER_MIN=120

# --- Integrations (used from Phase 3 onwards; can also be set per workspace in the UI) ---
KEEPA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Web ---
API_INTERNAL_URL=http://localhost:4000
